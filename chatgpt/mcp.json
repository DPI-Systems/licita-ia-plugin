{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "licita": {
      "type": "streamable-http",
      "url": "https://licita-ia.es/api/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "cimd" },
            "baseScopes": ["licita:leer", "licita:gestionar", "licita:agentes"]
          }
        }
      }
    }
  }
}
